    <OutputType>Exe</OutputType>
    <RootNamespace>WModel</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Tolerancing.Core\Tolerancing.Core.csproj" />
